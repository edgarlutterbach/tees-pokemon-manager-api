{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "PokeManager API",
    "description": "API de gerenciamento de Pokémons e Treinadores — disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Endpoints de gerenciamento de Pokémons"
    },
    {
      "name": "Trainers",
      "description": "Endpoints de gerenciamento de Treinadores"
    }
  ],
  "paths": {
    "/api/v1/pokemons/stats": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Estatísticas gerais do catálogo",
        "description": "Retorna o total de Pokémons cadastrados e a contagem por tipo.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/v1/pokemons/search": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca Pokémons por nome parcial",
        "description": "Busca case-insensitive por parte do nome. Retorna os resultados e o total do catálogo.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Termo de busca (ex: pika)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado da busca",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPokemonsResult"
                }
              }
            }
          },
          "400": {
            "description": "Termo de busca ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchBadRequestError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista todos os Pokémons",
        "description": "Retorna o catálogo completo, com filtro opcional por tipo.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filtra pelo tipo (ex: FIRE)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pokemon"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon pelo ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon existente",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon do catálogo",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso"
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/": {
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cadastra um novo Pokémon",
        "description": "",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um Pokémon cadastrado com este ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}/level": {
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza o nível de um Pokémon",
        "description": "Altera apenas o nível do Pokémon. O valor deve ser um inteiro entre 1 e 100.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Nível atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "400": {
            "description": "Nível ausente ou fora do intervalo permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonLevelDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cadastra um novo Treinador",
        "description": "O e-mail é único: cadastros repetidos retornam 409.",
        "responses": {
          "201": {
            "description": "Treinador cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trainer"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerBadRequestError"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerConflictError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrainerDto"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "nickname": {
            "type": "string",
            "example": "Pika"
          },
          "level": {
            "type": "number",
            "example": 25
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "nickname": {
            "type": "string",
            "example": "Pika"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "rarity",
          "hp",
          "attack",
          "defense"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Raichu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 50
          },
          "attack": {
            "type": "number",
            "example": 65
          },
          "defense": {
            "type": "number",
            "example": 45
          },
          "nickname": {
            "type": "string",
            "example": "Rai"
          }
        }
      },
      "UpdatePokemonLevelDto": {
        "type": "object",
        "properties": {
          "level": {
            "type": "number",
            "example": 25
          }
        },
        "required": [
          "level"
        ]
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f2b8c1e-6a4d-4e7b-9c2a-1d5e8f7a6b3c"
          },
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@pokemon.com"
          },
          "age": {
            "type": "number",
            "example": 10
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        }
      },
      "CreateTrainerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@pokemon.com"
          },
          "age": {
            "type": "number",
            "example": 10
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        },
        "required": [
          "name",
          "email",
          "age",
          "city"
        ]
      },
      "BadRequestError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Level deve ser um número inteiro entre 1 e 100."
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "Já existe um Pokémon cadastrado com este ID."
          }
        }
      },
      "TrainerBadRequestError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "E-mail inválido."
          }
        }
      },
      "TrainerConflictError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "Já existe um Treinador cadastrado com este e-mail."
          }
        }
      },
      "SearchPokemonsResult": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "example": "pika"
          },
          "totalMatches": {
            "type": "number",
            "example": 1
          },
          "totalCatalog": {
            "type": "number",
            "example": 6
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "25"
                },
                "name": {
                  "type": "string",
                  "example": "Pikachu"
                },
                "type": {
                  "type": "string",
                  "example": "ELECTRIC"
                },
                "rarity": {
                  "type": "string",
                  "example": "RARE"
                },
                "hp": {
                  "type": "number",
                  "example": 35
                },
                "attack": {
                  "type": "number",
                  "example": 55
                },
                "defense": {
                  "type": "number",
                  "example": 40
                },
                "nickname": {
                  "type": "string",
                  "example": "Pika"
                },
                "level": {
                  "type": "number",
                  "example": 25
                }
              }
            }
          }
        }
      },
      "SearchBadRequestError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "O parâmetro name é obrigatório para a busca."
          }
        }
      }
    }
  }
}