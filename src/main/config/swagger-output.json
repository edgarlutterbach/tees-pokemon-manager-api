{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "PokeManager API",
    "description": "API de gerenciamento de Pokémons e Treinadores — disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Endpoints de gerenciamento de Pokémons"
    },
    {
      "name": "Trainers",
      "description": "Endpoints de gerenciamento de Treinadores"
    }
  ],
  "paths": {
    "/api/v1/pokemons/stats": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Estatísticas gerais do catálogo",
        "description": "Retorna o total de Pokémons cadastrados e a contagem por tipo.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/v1/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista os Pokémons do catálogo de forma paginada",
        "description": "Retorna o catálogo ordenado por nome, com paginação e filtros opcionais por tipo e faixa de nível.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Número da página, a partir de 1 (padrão: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Itens por página, de 1 a 50 (padrão: 10)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Tipo, sem diferenciar maiúsculas (FIRE, GRASS, WATER, ELECTRIC, PSYCHIC, POISON, FLYING)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minLevel",
            "in": "query",
            "description": "Nível mínimo, de 1 a 100 (padrão: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "maxLevel",
            "in": "query",
            "description": "Nível máximo, de 1 a 100 (padrão: 100)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de Pokémons com metadados de paginação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPokemons"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros de busca inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPokemonsValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon pelo ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon existente",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso"
          },
          "400": {
            "description": "Dados de entrada inválidos ou corpo sem campos para atualizar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatePokemonValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado no catálogo ou novo nome inexistente na PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível ou sem resposta em 3 segundos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon do catálogo",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso"
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/": {
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cadastra um novo Pokémon",
        "description": "O nome é consultado na PokéAPI oficial, que fornece spriteUrl, baseExperience, height (decímetros) e weight (hectogramas). Esses quatro campos não são aceitos no corpo.",
        "responses": {
          "201": {
            "description": "Pokémon criado e enriquecido com os dados da PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedPokemon"
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePokemonValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Nome não encontrado na base oficial da PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PokeApiNotFoundError"
                }
              }
            }
          },
          "409": {
            "description": "ID de Pokémon já cadastrado ou time do treinador completo (máximo de 6)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictError"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível ou sem resposta em 3 segundos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}/level": {
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza o nível de um Pokémon",
        "description": "Altera apenas o nível do Pokémon. O valor deve ser um inteiro entre 1 e 100.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Nível atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pokemon"
                }
              }
            }
          },
          "400": {
            "description": "Nível ausente ou fora do intervalo permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePokemonLevelDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cadastra um novo Treinador",
        "description": "O e-mail é único: cadastros repetidos retornam 409.",
        "responses": {
          "201": {
            "description": "Treinador cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trainer"
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTrainerValidationError"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerConflictError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrainerDto"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{id}": {
      "delete": {
        "tags": [
          "Trainers"
        ],
        "summary": "Remove um Treinador",
        "description": "Os Pokémons do treinador não são removidos: ficam sem treinador (selvagens).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID (UUID) do Treinador"
          }
        ],
        "responses": {
          "204": {
            "description": "Treinador removido com sucesso"
          },
          "400": {
            "description": "ID em formato inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerIdValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerNotFoundError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "nickname": {
            "type": "string",
            "example": "Pika"
          },
          "level": {
            "type": "number",
            "example": 25
          },
          "trainerId": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "spriteUrl": {
            "type": "string",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "baseExperience": {
            "type": "number",
            "example": 112
          },
          "height": {
            "type": "number",
            "example": 4
          },
          "weight": {
            "type": "number",
            "example": 60
          }
        }
      },
      "CreatedPokemon": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Pokémon cadastrado com sucesso!"
          },
          "data": {
            "$ref": "#/components/schemas/Pokemon"
          }
        }
      },
      "PaginatedPokemons": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pokemon"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "number",
                "example": 1
              },
              "limit": {
                "type": "number",
                "example": 10
              },
              "total": {
                "type": "number",
                "example": 45
              }
            }
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "nickname": {
            "type": "string",
            "example": "Pika"
          },
          "level": {
            "type": "number",
            "example": 25
          },
          "trainerId": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "rarity",
          "hp",
          "attack",
          "defense"
        ]
      },
      "UpdatePokemonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Raichu"
          },
          "type": {
            "type": "string",
            "example": "ELECTRIC"
          },
          "rarity": {
            "type": "string",
            "example": "RARE"
          },
          "hp": {
            "type": "number",
            "example": 50
          },
          "attack": {
            "type": "number",
            "example": 65
          },
          "defense": {
            "type": "number",
            "example": 45
          },
          "nickname": {
            "type": "string",
            "example": "Rai"
          }
        }
      },
      "UpdatePokemonLevelDto": {
        "type": "object",
        "properties": {
          "level": {
            "type": "number",
            "example": 25
          }
        },
        "required": [
          "level"
        ]
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f2b8c1e-6a4d-4e7b-9c2a-1d5e8f7a6b3c"
          },
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@pokemon.com"
          },
          "age": {
            "type": "number",
            "example": 10
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        }
      },
      "CreateTrainerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@pokemon.com"
          },
          "age": {
            "type": "number",
            "example": 10
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        },
        "required": [
          "name",
          "email",
          "age",
          "city"
        ]
      },
      "BadRequestError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Level deve ser um número inteiro entre 1 e 100."
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      },
      "PokeApiNotFoundError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado na base oficial da PokeAPI"
          }
        }
      },
      "ServiceUnavailableError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 503
          },
          "message": {
            "type": "string",
            "example": "O serviço externo da PokeAPI está temporariamente indisponível. Tente novamente mais tarde"
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "Já existe um Pokémon cadastrado com este ID."
          }
        }
      },
      "TrainerConflictError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "Já existe um registro cadastrado com este e-mail."
          }
        }
      },
      "TrainerNotFoundError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Treinador não encontrado no banco de dados"
          }
        }
      },
      "TrainerIdValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Dados de entrada inválidos"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "id"
                },
                "message": {
                  "type": "string",
                  "example": "O parâmetro id deve ser um UUID válido"
                }
              }
            }
          }
        }
      },
      "SearchPokemonsResult": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "example": "pika"
          },
          "totalMatches": {
            "type": "number",
            "example": 1
          },
          "totalCatalog": {
            "type": "number",
            "example": 6
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pokemon"
            }
          }
        }
      },
      "ListPokemonsValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Dados de entrada inválidos"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "minLevel"
                },
                "message": {
                  "type": "string",
                  "example": "O parâmetro minLevel deve ser um número inteiro"
                }
              }
            }
          }
        }
      },
      "CreatePokemonValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Dados de entrada inválidos"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "trainerId"
                },
                "message": {
                  "type": "string",
                  "example": "O campo trainerId deve ser um UUID válido"
                }
              }
            }
          }
        }
      },
      "UpdatePokemonValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Dados de entrada inválidos"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "name"
                },
                "message": {
                  "type": "string",
                  "example": "O campo name deve ser um texto"
                }
              }
            }
          }
        }
      },
      "CreateTrainerValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
