# Aplicação
PORT=3333
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=pokemanager
POSTGRES_PASSWORD=pokemanager
POSTGRES_DB=pokemanager
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pokemanager:pokemanager@localhost:5432/pokemanager

# Integração externa (false = PokéAPI simulada em memória)
USE_EXTERNAL_API=true

# Autenticação (gere um valor próprio; nunca reutilize este exemplo)
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-bytes

# Seed: primeiro administrador
SEED_ADMIN_EMAIL=admin@pokemanager.com
SEED_ADMIN_PASSWORD=troque-esta-senha